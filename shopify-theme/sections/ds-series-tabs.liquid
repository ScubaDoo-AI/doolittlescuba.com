{%- comment -%}
  Rendered from layout/theme.liquid on every product template (not placed in the product templates).
  Series tab bar on product pages (Eric, 25 Nov 2026: "All collections must use the scrolling tabs when viewing a series").
  The same scrolling tabs as the collection deck, linked to each collection page, with the product's own series lit.
  A product in a series sub-collection (Boat Banter, Site Caps, Sticker Packs ...) also gets a "Back to" chip for it.
  The tab list mirrors the deck tabs in templates/collection.json; keep the two in step when a tab is added.
{%- endcomment -%}
{%- liquid
  assign t_handles = 'signature-series|certified-ish|aquatic-comic|hats|pairs|organic|jackets|stickers|water-hazard|custom|*|1n73ll1g3nc3|off-world-hunt-club' | split: '|'
  assign t_labels = 'Signature Series|Certified-ish|Surface Interval|Caps & beanies|Cap & tee pairs|Organic|Jackets|Stickers|Hand towels|Custom|Off topic|1N73LL1G3NC3|Off-World Hunt Club' | split: '|'
  # which tab a product belongs to, most specific first
  assign priority = 'custom|water-hazard|pairs|organic|jackets|stickers|hats|1n73ll1g3nc3|off-world-hunt-club|certified-ish|aquatic-comic|signature-series' | split: '|'
  assign subs = 'aquatic-comic-boat-banter|aquatic-comic-self-logged|aquatic-comic-buddy-check|aquatic-comic-buddy-system|aquatic-comic-till-surface|aquatic-comic-master-class|site-caps|brand-caps|achievement-unlocked|sticker-packs|die-cut-stickers|brand-stickers' | split: '|'
  assign p_handles = product.collections | map: 'handle'
  assign is_custom = false
  if product.tags contains 'series-custom' or product.tags contains 'personalized' or product.tags contains 'home-port'
    assign is_custom = true
  endif
  assign active = ''
  if is_custom
    assign active = 'custom'
  else
    for h in priority
      if h == 'custom'
        continue
      endif
      if p_handles contains h
        assign active = h
        break
      endif
    endfor
    if product.tags contains 'organic-line'
      assign active = 'organic'
    endif
  endif
  assign sub_c = blank
  if is_custom == false
  for h in subs
    if p_handles contains h
      assign sub_c = collections[h]
      break
    endif
  endfor
  endif
-%}
{%- if active != '' -%}
<div class="dss section-{{ section.id }}">
  <nav class="dsd-tabs" aria-label="Collections">
    {%- for h in t_handles -%}
      {%- if h == '*' -%}<span class="dsd-group">{{ t_labels[forloop.index0] }}</span>{%- continue -%}{%- endif -%}
      {%- assign c = collections[h] -%}
      {%- if c == blank or c.handle == blank -%}{%- continue -%}{%- endif -%}
      <a class="dsd-tab{% if h == active %} is-on{% endif %}" href="{{ c.url }}"{% if h == active %} aria-current="true"{% endif %}>{{ t_labels[forloop.index0] }}</a>
    {%- endfor -%}
  </nav>
  {%- if sub_c != blank -%}
    <div class="dss-back"><a href="{{ sub_c.url }}">&larr; {{ sub_c.title }}</a></div>
  {%- elsif active != '' -%}
    {%- assign ac = collections[active] -%}
    <div class="dss-back"><a href="{{ ac.url }}">&larr; All {{ ac.title }}</a></div>
  {%- endif -%}
</div>
<script>
(function(){
  var root=document.currentScript.previousElementSibling; if(!root) return;
  var bar=root.querySelector('.dsd-tabs'); if(!bar) return;
  function edge(){ var l=bar.scrollLeft>4, r=bar.scrollLeft+bar.clientWidth<bar.scrollWidth-4; bar.classList.toggle('fade-l',l&&!r); bar.classList.toggle('fade-r',r&&!l); bar.classList.toggle('fade-lr',l&&r); }
  function centre(){ var on=bar.querySelector('.is-on'); if(on){ bar.scrollLeft=Math.max(0,on.offsetLeft-(bar.clientWidth-on.offsetWidth)/2); } edge(); }
  bar.addEventListener('scroll',edge,{passive:true});
  bar.addEventListener('wheel',function(e){ if(bar.scrollWidth<=bar.clientWidth||Math.abs(e.deltaX)>Math.abs(e.deltaY)) return; e.preventDefault(); bar.scrollLeft+=e.deltaY; },{passive:false});
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',centre); else requestAnimationFrame(centre);
  addEventListener('load',centre); addEventListener('resize',edge);
})();
</script>
<style>
.dss{max-width:var(--page-width,1440px);margin-inline:auto;padding:{{ section.settings.padding_top }}px var(--page-margin,40px) {{ section.settings.padding_bottom }}px;box-sizing:border-box}
.dss .dsd-tabs{position:relative;display:flex;gap:6px;overflow-x:auto;scrollbar-width:none;padding-bottom:4px;border-bottom:1px solid rgb(var(--color-foreground-rgb) / .14)}
.dss .dsd-tabs::-webkit-scrollbar{display:none}
.dss .dsd-tab{flex:0 0 auto;color:inherit;font-size:15px;padding:10px 14px 9px;text-decoration:none;white-space:nowrap;opacity:.72;border-bottom:3px solid transparent;margin-bottom:-5px}
.dss .dsd-tab:hover{opacity:1}
.dss .dsd-tab.is-on{opacity:1;font-weight:600;border-bottom-color:#C8202A}
.dss .dsd-tab:focus-visible,.dss-back a:focus-visible{outline:2px solid #C8202A;outline-offset:2px}
.dss .dsd-group{flex:0 0 auto;align-self:center;margin-left:14px;padding:4px 10px 4px 14px;border-left:1px solid rgb(var(--color-foreground-rgb) / .25);font-size:11px;letter-spacing:.12em;text-transform:uppercase;opacity:.55;white-space:nowrap}
.dss .dsd-tabs.fade-r{-webkit-mask-image:linear-gradient(90deg,#000 calc(100% - 56px),transparent);mask-image:linear-gradient(90deg,#000 calc(100% - 56px),transparent)}
.dss .dsd-tabs.fade-l{-webkit-mask-image:linear-gradient(90deg,transparent,#000 56px);mask-image:linear-gradient(90deg,transparent,#000 56px)}
.dss .dsd-tabs.fade-lr{-webkit-mask-image:linear-gradient(90deg,transparent,#000 56px,#000 calc(100% - 56px),transparent);mask-image:linear-gradient(90deg,transparent,#000 56px,#000 calc(100% - 56px),transparent)}
.dss-back{margin-top:10px;font-size:14px}
.dss-back a{color:inherit;opacity:.8;text-decoration:none}
.dss-back a:hover{opacity:1;text-decoration:underline}
</style>
{%- endif -%}

{% schema %}
{
  "name": "Series tabs",
  "tag": "section",
  "class": "section-ds-series-tabs",
  "settings": [
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 4 }
  ],
  "presets": [ { "name": "Series tabs" } ]
}
{% endschema %}
