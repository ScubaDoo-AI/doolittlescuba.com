{%- comment -%}
  Doolittle Scuba — Home Port pin picker for the custom Home Port cap.
  Shows on products tagged home-port. The customer names the port and drops a pin; the port name, coordinates
  (in the Signature Series format), decimal position and flag (dive flag in the US, Alpha flag elsewhere) travel as
  line item properties on the buy-buttons form of the same section, so they show in Shopify admin, the order email
  and the Printful draft. Add to cart is held until a pin is placed.
  Add to cart also adds the one-time embroidery digitization (DS-DIGI-1, $7) for the port, once per port however many
  caps (Eric, 20 Nov 2026); the custom-orders job holds an order whose port fee is missing. Buy-it-now buttons are
  hidden here, since they would skip both.
{%- endcomment -%}
{%- liquid
  assign product = closest.product
  assign form_id = 'BuyButtons-ProductForm-' | append: section.id
  assign uid = 'hp-' | append: block.id
-%}
{%- if product.tags contains 'home-port' -%}
  <div class="ds-hp" id="{{ uid }}" data-form="{{ form_id }}" {{ block.shopify_attributes }}>
    <p class="ds-hp__title">{{ block.settings.heading }}</p>
    <p class="ds-hp__intro">{{ block.settings.intro }}</p>

    <label class="ds-hp__field">
      <span>Port name on the cap</span>
      <input type="text" name="properties[Home Port name]" form="{{ form_id }}" maxlength="{{ block.settings.max_name }}" required autocomplete="off" placeholder="e.g. Lake Lanier" data-hp-name>
    </label>

    <div class="ds-hp__search">
      <input type="search" placeholder="Search a marina, dive site or town" aria-label="Search for a place" data-hp-q>
      <button type="button" data-hp-go>Search</button>
    </div>
    <ul class="ds-hp__results" data-hp-results hidden></ul>

    <div class="ds-hp__map" data-hp-map role="application" aria-label="Map: click or tap to drop your Home Port pin"></div>
    <p class="ds-hp__hint">Click or tap the map to drop the pin. Drag it to fine-tune.</p>

    <label class="ds-hp__field">
      <span>Coordinates</span>
      <input type="text" name="properties[Home Port coordinates]" form="{{ form_id }}" required autocomplete="off" placeholder="Drop a pin on the map" data-hp-coords>
    </label>
    <input type="hidden" name="properties[_Home Port lat,lon]" form="{{ form_id }}" data-hp-dec>
    <input type="hidden" name="properties[Home Port flag]" form="{{ form_id }}" data-hp-flag>

    <div class="ds-hp__preview" aria-live="polite">
      <span class="ds-hp__pv-label">Home Port:</span>
      <span class="ds-hp__flag ds-hp__flag--dive" data-hp-pvflag aria-hidden="true"></span>
      <span class="ds-hp__pv-name" data-hp-pvname>Your Port</span>
      <span class="ds-hp__pv-c" data-hp-pvlat>00°00.000'N</span>
      <span class="ds-hp__pv-c" data-hp-pvlon>000°00.000'W</span>
    </div>
    <p class="ds-hp__note">{{ block.settings.note }}</p>
    <div class="ds-hp__sizes">
      <p class="ds-hp__title">How many caps with this Home Port?</p>
      {%- for v in product.variants -%}
        <div class="ds-hp__size" data-hp-row data-variant="{{ v.id }}" data-price="{{ v.price }}">
          <span class="ds-hp__sz">{{ v.title }}</span>
          <span class="ds-hp__step">
            <button type="button" data-hp-minus aria-label="One fewer {{ v.title }}">&minus;</button>
            <output data-hp-n>{% if forloop.first %}1{% else %}0{% endif %}</output>
            <button type="button" data-hp-plus aria-label="One more {{ v.title }}">+</button>
          </span>
        </div>
      {%- endfor -%}
      <p class="ds-hp__total" data-hp-total aria-live="polite"></p>
      <button type="button" class="ds-hp__add" data-hp-add>Add to cart</button>
      <p class="ds-hp__msg" data-hp-msg role="status" aria-live="polite"></p>
    </div>
    <p class="ds-hp__note">Plus a one-time $7 to digitize your port for embroidery, once per port however many caps.</p>
  </div>

  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Almendra:wght@700&display=swap">
  <style>
    .ds-hp{display:flex;flex-direction:column;gap:10px;width:100%}
    .ds-hp__title{margin:0;font-weight:600}
    .ds-hp__intro,.ds-hp__hint,.ds-hp__note{margin:0;font-size:.85em;opacity:.8}
    .ds-hp__field{display:flex;flex-direction:column;gap:4px;font-size:.9em}
    .ds-hp input[type=text],.ds-hp input[type=search]{min-height:44px;padding:0 12px;border:1px solid rgb(var(--color-foreground-rgb,0 0 0) / .45);border-radius:4px;background:transparent;color:inherit;font:inherit;width:100%;box-sizing:border-box}
    .ds-hp__search{display:flex;gap:8px}
    .ds-hp__search button{min-height:44px;padding:0 16px;border-radius:4px;border:1px solid currentColor;background:transparent;color:inherit;font:inherit;cursor:pointer}
    .ds-hp__results{list-style:none;margin:0;padding:0;border:1px solid rgb(var(--color-foreground-rgb,0 0 0) / .2);border-radius:4px;max-height:180px;overflow:auto}
    .ds-hp__results button{display:block;width:100%;text-align:left;padding:10px 12px;border:0;background:transparent;color:inherit;font:inherit;font-size:.85em;cursor:pointer}
    .ds-hp__results button:hover,.ds-hp__results button:focus{background:rgb(var(--color-foreground-rgb,0 0 0) / .08)}
    .ds-hp__map{height:300px;border-radius:6px;overflow:hidden;z-index:0}
    .ds-hp__preview{display:flex;flex-direction:column;align-items:center;gap:4px;padding:16px;border-radius:6px;background:#111;color:#fff;font-family:Almendra,Georgia,serif;font-weight:700;text-align:center;line-height:1.1}
    .ds-hp__pv-label{font-size:1em}
    .ds-hp__pv-name{font-size:1.45em}
    .ds-hp__pv-c{font-size:1.05em}
    .ds-hp__flag{display:block;width:54px;height:34px;border:2px solid #fff;margin:2px 0 4px}
    .ds-hp__flag--dive{background:linear-gradient(to top right,#eb1700 calc(50% - 5px),#fff calc(50% - 5px),#fff calc(50% + 5px),#eb1700 calc(50% + 5px))}
    body:has(.ds-hp) shopify-accelerated-checkout,body:has(.ds-hp) .shopify-payment-button{display:none!important}
    body:has(.ds-hp) variant-picker,body:has(.ds-hp) .buy-buttons-block{display:none!important}
    .ds-hp__sizes{display:flex;flex-direction:column;gap:8px;padding-top:6px}
    .ds-hp__size{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:6px 0;border-bottom:1px solid rgb(var(--color-foreground-rgb,0 0 0) / .14)}
    .ds-hp__sz{font-weight:600}
    .ds-hp__step{display:inline-flex;align-items:center;border:1px solid rgb(var(--color-foreground-rgb,0 0 0) / .45);border-radius:4px}
    .ds-hp__step button{width:44px;height:44px;border:0;background:transparent;color:inherit;font:inherit;font-size:1.2em;cursor:pointer}
    .ds-hp__step output{min-width:2.2em;text-align:center}
    .ds-hp__total{margin:4px 0 0;font-size:.95em}
    .ds-hp__add{min-height:50px;border:0;border-radius:4px;background:#B9262F;color:#fff;font:inherit;font-weight:600;letter-spacing:.04em;cursor:pointer}
    .ds-hp__add[disabled]{opacity:.55;cursor:default}
    .ds-hp__msg{margin:0;font-size:.85em;min-height:1.2em}
    .ds-hp__flag--alpha{background:linear-gradient(90deg,#fff 50%,#0800ff 50%);clip-path:polygon(0 0,100% 0,72% 50%,100% 100%,0 100%)}
  </style>
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin="" defer></script>
  <script>
    (function(){
      var root=document.getElementById('{{ uid }}'); if(!root) return;
      function q(s){return root.querySelector(s);}
      var nameEl=q('[data-hp-name]'),coordsEl=q('[data-hp-coords]'),decEl=q('[data-hp-dec]'),flagEl=q('[data-hp-flag]');
      var resEl=q('[data-hp-results]'),qEl=q('[data-hp-q]');
      var form=document.getElementById(root.dataset.form);
      var setVal='';
      function ddm(v,pos,neg,w){var h=(v>0||(v===0&&pos==='N'))?pos:neg;v=Math.abs(v);var d=Math.floor(v);var m=Math.round((v-d)*60*1000)/1000;if(m>=60){d+=1;m=0;}var ds=String(d).padStart(w,'0');var ms=m.toFixed(3).padStart(6,'0');return ds+'°'+ms+"'"+h;}
      function inUS(lat,lon){return lat>=17&&lat<=72&&lon>=-180&&lon<=-64;}
      var map,marker;
      function place(lat,lon,label){
        lon=((lon+540)%360)-180;
        var la=ddm(lat,'N','S',2),lo=ddm(lon,'E','W',3);
        setVal=la+' '+lo; coordsEl.value=setVal; coordsEl.setCustomValidity('');
        decEl.value=lat.toFixed(6)+','+lon.toFixed(6);
        var flag=inUS(lat,lon)?'Dive flag':'Alpha flag'; flagEl.value=flag;
        q('[data-hp-pvlat]').textContent=la; q('[data-hp-pvlon]').textContent=lo;
        var f=q('[data-hp-pvflag]'); f.className='ds-hp__flag '+(flag==='Dive flag'?'ds-hp__flag--dive':'ds-hp__flag--alpha');
        if(label&&!nameEl.value){nameEl.value=label.slice(0,nameEl.maxLength); updName();}
        if(map){ if(!marker){marker=L.marker([lat,lon],{draggable:true}).addTo(map);marker.on('dragend',function(){var p=marker.getLatLng();place(p.lat,p.lng);});} else marker.setLatLng([lat,lon]); }
        pinLat=lat; pinLon=lon; save();
      }
      /* The pin and name are kept in this browser, so more caps (or another size) can be added later without pinning again. */
      var pinLat=null,pinLon=null,KEY='dsHomePort';
      function save(){ try{ localStorage.setItem(KEY,JSON.stringify({name:nameEl.value,lat:pinLat,lon:pinLon})); }catch(e){} }
      function restore(){ try{ var s=JSON.parse(localStorage.getItem(KEY)||'null'); if(!s) return;
        if(s.name&&!nameEl.value){ nameEl.value=s.name; updName(); }
        if(typeof s.lat==='number'&&typeof s.lon==='number'){ place(s.lat,s.lon); if(map) map.setView([s.lat,s.lon],11); } }catch(e){} }
      function updName(){q('[data-hp-pvname]').textContent=nameEl.value.trim()||'Your Port';}
      nameEl.addEventListener('input',function(){updName();save();});
      coordsEl.addEventListener('input',function(){coordsEl.value=setVal;});
      coordsEl.addEventListener('invalid',function(){coordsEl.setCustomValidity(setVal?'':'Drop a pin on the map to set your Home Port coordinates.');});
      /* The buy-buttons form comes after this block in the page, so it is looked up when it is submitted. */
      window.addEventListener('submit',function(e){if(!e.target||e.target.id!==root.dataset.form)return;form=e.target;if(!setVal){e.preventDefault();e.stopImmediatePropagation();coordsEl.setCustomValidity('Drop a pin on the map to set your Home Port coordinates.');coordsEl.reportValidity();}},true);
      /* $7 digitization, once per port (Eric, 20 Nov 2026). The theme adds the cap itself; when the cart changes
         (Shopify's standard shopify:cart:lines-update event, which carries a promise that settles once the add is
         done) and on page load, any Home Port cap in the cart without a fee line for its port gets one, then the
         cart page opens so both lines show. */
      var DIGI=51027378864314,R=(window.Shopify&&Shopify.routes&&Shopify.routes.root)||'/',busy=false;
      function pk(p){p=p||{};return (p['Home Port name']||'').trim()+'|'+(p['Home Port coordinates']||'').trim();}
      function ensureFees(go){
        if(busy) return; busy=true;
        fetch(R+'cart.js',{headers:{'Accept':'application/json'}}).then(function(r){return r.json();}).then(function(cart){
          var have={},need={},items=[];
          (cart.items||[]).forEach(function(i){ if(i.variant_id===DIGI) have[pk(i.properties)]=1; });
          (cart.items||[]).forEach(function(i){ var p=i.properties||{};
            if(/^DS-HMP-/.test(i.sku||'')&&p['Home Port name']){ var k=pk(p); if(!have[k]&&!need[k]){ need[k]=1;
              items.push({id:DIGI,quantity:1,properties:{'Home Port name':p['Home Port name'].trim(),'Home Port coordinates':(p['Home Port coordinates']||'').trim(),'Home Port flag':p['Home Port flag']||''}}); } } });
          if(!items.length){ busy=false; return; }
          return fetch(R+'cart/add.js',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({items:items})})
            .then(function(r){ busy=false; if(r.ok&&go) window.location.href=R+'cart'; });
        }).catch(function(){busy=false;});
      }
      window.addEventListener('shopify:cart:lines-update',function(e){
        var pr=e.promise||(e.detail&&e.detail.promise);
        Promise.resolve(pr).catch(function(){}).then(function(){ setTimeout(function(){ensureFees(true);},300); setTimeout(function(){ensureFees(true);},2500); });
      },true);
      ensureFees(false);
      function search(){
        var s=qEl.value.trim(); if(!s) return;
        fetch('https://nominatim.openstreetmap.org/search?format=json&limit=5&q='+encodeURIComponent(s),{headers:{'Accept-Language':'en'}})
          .then(function(r){return r.json();}).then(function(list){
            resEl.innerHTML=''; resEl.hidden=!list.length;
            list.forEach(function(it){var li=document.createElement('li');var b=document.createElement('button');b.type='button';b.textContent=it.display_name;b.addEventListener('click',function(){var lat=+it.lat,lon=+it.lon;resEl.hidden=true;if(map)map.setView([lat,lon],13);place(lat,lon,(it.name||'').trim());});li.appendChild(b);resEl.appendChild(li);});
          }).catch(function(){resEl.hidden=true;});
      }
      q('[data-hp-go]').addEventListener('click',search);
      qEl.addEventListener('keydown',function(e){if(e.key==='Enter'){e.preventDefault();search();}});
      function init(){
        if(!window.L) return setTimeout(init,150);
        map=L.map(q('[data-hp-map]'),{scrollWheelZoom:false}).setView([33.38,-84.8],4);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:18,attribution:'&copy; OpenStreetMap contributors'}).addTo(map);
        map.on('click',function(e){place(e.latlng.lat,e.latlng.lng);});
        restore();
      }
      init();
      /* Sizes: a count per size, one Add to cart for all of them, plus the port's $7 fee once. */
      var rows=[].slice.call(root.querySelectorAll('[data-hp-row]')),addBtn=q('[data-hp-add]'),msg=q('[data-hp-msg]'),tot=q('[data-hp-total]');
      function money(c){return '$'+(c/100).toFixed(2).replace(/\.00$/,'');}
      function counts(){ return rows.map(function(r){return {id:+r.dataset.variant,n:+r.querySelector('[data-hp-n]').value||+r.querySelector('[data-hp-n]').textContent||0,price:+r.dataset.price||0,size:r.querySelector('.ds-hp__sz').textContent};}); }
      function refresh(){ var c=counts(),n=0,sum=0; c.forEach(function(x){n+=x.n;sum+=x.n*x.price;});
        tot.textContent=n?(n+' cap'+(n>1?'s':'')+' \u00b7 '+money(sum)+' + '+money(700)+' digitization (once for this port)'):'Choose at least one cap.';
        addBtn.disabled=!n; }
      rows.forEach(function(r){ var o=r.querySelector('[data-hp-n]');
        r.querySelector('[data-hp-minus]').addEventListener('click',function(){ var v=Math.max(0,(+o.textContent||0)-1); o.textContent=v; o.value=v; refresh(); });
        r.querySelector('[data-hp-plus]').addEventListener('click',function(){ var v=Math.min(20,(+o.textContent||0)+1); o.textContent=v; o.value=v; refresh(); }); });
      refresh();
      addBtn.addEventListener('click',function(){
        var n=nameEl.value.trim();
        if(!n){ nameEl.reportValidity(); nameEl.focus(); return; }
        if(!setVal){ msg.textContent='Drop a pin on the map to set your Home Port coordinates.'; return; }
        var props={'Home Port name':n,'Home Port coordinates':setVal,'_Home Port lat,lon':decEl.value,'Home Port flag':flagEl.value};
        var items=counts().filter(function(x){return x.n>0;}).map(function(x){return {id:x.id,quantity:x.n,properties:props};});
        if(!items.length) return;
        addBtn.disabled=true; msg.textContent='Adding to your cart\u2026'; busy=true;
        fetch(R+'cart.js',{headers:{'Accept':'application/json'}}).then(function(r){return r.json();}).then(function(cart){
          var has=(cart.items||[]).some(function(i){return i.variant_id===DIGI&&pk(i.properties)===pk(props);});
          if(!has) items.push({id:DIGI,quantity:1,properties:{'Home Port name':n,'Home Port coordinates':setVal,'Home Port flag':flagEl.value}});
          return fetch(R+'cart/add.js',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({items:items})});
        }).then(function(r){ if(!r.ok) throw new Error('add'); window.location.href=R+'cart'; })
          .catch(function(){ busy=false; addBtn.disabled=false; msg.textContent='Sorry, that didn\u2019t go in. Please try again.'; });
      });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Home Port pin picker",
  "tag": null,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Set your Home Port" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "The place you dive from, or the one you call home. Search for it or drop a pin." },
    { "type": "range", "id": "max_name", "label": "Port name length", "min": 8, "max": 20, "step": 1, "default": 16 },
    { "type": "textarea", "id": "note", "label": "Note", "default": "Embroidered to order exactly as shown. US ports get the dive flag, ports abroad the Alpha flag. We check every Home Port before it is stitched." }
  ],
  "presets": [ { "name": "Home Port pin picker", "category": "Product" } ]
}
{% endschema %}
