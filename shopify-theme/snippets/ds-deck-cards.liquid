{%- doc -%}
  Deck of product cards. On the organic collection each card carries data-sub (its line, from the organic:<line> tag;
  the beanie joins the caps) so the section can split the deck into sub-tabs (Eric, 21 Nov 2026).
  Deck of product cards. Signature Series products first, off-topic lines last, custom items only in the custom tab, organic editions hidden unless the collection is the organic one.
  Each card's spine (and its tag's top border) is the garment's own colour from the product's colour: tag (Eric, 20 Nov 2026:
  "These should match for every product"), with dark ink on light colours.
  @param {product[]} products
  @param {collection} coll
  @param {string} label
  @param {number} limit
  @param {boolean} hide_organic
  @param {boolean} see_all
{%- enddoc -%}
{%- liquid
  assign organic_coll = false
  if coll.handle == 'organic' or coll.handle == 'eco'
    assign organic_coll = true
  endif
  assign shown = 0
  assign total = 0
-%}
<div class="dsd-deck">
  {%- for pass in (1..3) -%}
    {%- for p in products -%}
      {%- liquid
        assign is_sig = false
        if p.tags contains 'signature-series' or p.tags contains 'signature-series-dark'
          assign is_sig = true
        endif
        # custom items have their own tab (Eric, 22 Nov 2026: "Maybe all custom items should be under their own tab"):
        # series custom shirts, Make it yours, Home Port and the personalized name tees show only in the custom collection
        # (the organic name tees also stay in the organic tab)
        assign is_custom = false
        if p.tags contains 'series-custom' or p.tags contains 'personalized' or p.tags contains 'home-port'
          assign is_custom = true
        endif
        if is_custom and coll.handle != 'custom' and organic_coll == false
          continue
        endif
        if pass == 1 and is_sig == false
          continue
        endif
        assign off_topic = false
        if p.tags contains '1n73ll1g3nc3' or p.tags contains 'off-world-hunt-club' or p.tags contains 'off-world-hunt-club-dark'
          assign off_topic = true
        endif
        if pass == 2 and is_sig or pass == 2 and off_topic
          continue
        endif
        if pass == 3 and is_sig or pass == 3 and off_topic == false
          continue
        endif
        if hide_organic and organic_coll == false and p.tags contains 'organic-line'
          continue
        endif
        assign total = total | plus: 1
        if shown >= limit
          continue
        endif
        assign shown = shown | plus: 1
        assign parts = p.title | split: '—'
        assign first_part = parts.first | strip
        assign last_part = parts.last | strip | remove: ' organic tee' | remove: ' organic cap' | remove: ' organic beanie' | remove: ' Dark tee' | remove: ' tee' | remove: ' Dark cap' | remove: ' cap'
        assign line_first = false
        if last_part contains 'Water Hazard' or p.tags contains 'towel'
          # Water Hazard towels (22 Nov 2026; hanging hand towels since 25 Nov): "Surface Interval — Hanging Hand Towel" is a towel, not the shirt line
        elsif first_part contains '1N73' or first_part contains 'Certified-ish' or first_part contains 'Off-World' or first_part contains 'Surface Interval'
          assign line_first = true
        endif
        if parts.size > 1 and line_first
          assign nm = last_part
          assign ln = first_part
        elsif parts.size > 1
          assign nm = first_part
          assign ln = last_part
        else
          assign nm = last_part
          assign ln = label
        endif
        if p.tags contains 'series-custom'
          # series custom shirts (22 Nov 2026): "Signature Series — Make it yours, light tee" → card "Make it yours, light", line "Signature Series"
          assign nm = last_part
          assign ln = first_part
        endif
        # Line labels that came out as a bare word from the title (25 Nov 2026 review): "Bali — Dark cap" read "Dark",
        # "Bali — organic cap" read "organic", "The Side Mark — cap" read "cap".
        assign is_capish = false
        if p.title contains ' cap' or p.title contains 'eanie'
          assign is_capish = true
        endif
        case ln
          when 'Dark'
            if is_capish
              assign ln = 'Site cap'
            endif
          when 'organic'
            assign ln = 'Organic cap'
          when 'organic beanie'
            assign ln = 'Organic beanie'
          when 'cap'
            assign ln = 'Brand cap'
          when 'Beanie'
            assign ln = 'Brand beanie'
          when 'personalized'
            assign ln = 'Personalized tee'
        endcase
        assign light_pic = false
        if p.tags contains 'towel'
          assign light_pic = true
        endif
        assign colour = ''
        for t in p.tags
          if t contains 'colour:'
            assign colour = t | remove: 'colour:' | replace: '-', ' ' | capitalize
            break
          endif
        endfor
        assign key = colour | downcase | replace: ' ', '-'
        # Cap-and-tee pairs (Eric, 21 Nov 2026): the spine is split on a diagonal, the cap's shade on top and the
        # tee's colour below, from the pair's cap-colour: and tee-colour: tags.
        assign cap_key = ''
        if p.tags contains 'pair'
          for t in p.tags
            if t contains 'tee-colour:'
              assign key = t | remove: 'tee-colour:'
            elsif t contains 'cap-colour:'
              assign cap_key = t | remove: 'cap-colour:'
            endif
          endfor
          assign colour = cap_key | replace: '-', ' ' | capitalize | append: ' cap · ' | append: key | replace: '-', ' ' | append: ' tee'
          assign colour = colour | capitalize
        endif
        assign ink = '#F3F6F9'
        case key
          when 'aqua'
            assign hex = '#7FCFD1'
            assign ink = '#122A55'
          when 'berry-pink'
            assign hex = '#E0527A'
          when 'black'
            assign hex = '#212327'
          when 'blue-spruce'
            assign hex = '#3A5752'
          when 'butter'
            assign hex = '#F5E9A8'
            assign ink = '#122A55'
          when 'caribbean-blue'
            assign hex = '#4FA3D8'
            assign ink = '#122A55'
          when 'charcoal'
            assign hex = '#3E3F42'
          when 'coral'
            assign hex = '#E8716C'
            assign ink = '#122A55'
          when 'dark-grey'
            assign hex = '#484A4B'
          when 'denim'
            assign hex = '#3F5163'
          when 'desert-dust'
            assign hex = '#D6C3A5'
            assign ink = '#122A55'
          when 'emerald'
            assign hex = '#0F6156'
          when 'espresso'
            assign hex = '#4B3631'
          when 'flo-blue'
            assign hex = '#7888D2'
          when 'french-navy'
            assign hex = '#1E2A44'
          when 'granite'
            assign hex = '#A6ABAA'
            assign ink = '#122A55'
          when 'grape'
            assign hex = '#332552'
          when 'graphite'
            assign hex = '#262C33'
          when 'heather-grey'
            assign hex = '#B9BBBD'
            assign ink = '#122A55'
          when 'ivory'
            assign hex = '#F2EBD9'
            assign ink = '#122A55'
          when 'jungle'
            assign hex = '#2F4A3A'
          when 'khaki'
            assign hex = '#B5A584'
            assign ink = '#122A55'
          when 'lagoon-blue'
            assign hex = '#86C9C6'
            assign ink = '#122A55'
          when 'lavender'
            assign hex = '#D5C2E0'
            assign ink = '#122A55'
          when 'light-blue'
            assign hex = '#C9DCEC'
            assign ink = '#122A55'
          when 'midnight'
            assign hex = '#22365A'
          when 'mint'
            assign hex = '#9FDCC8'
            assign ink = '#122A55'
          when 'moss'
            assign hex = '#27392E'
          when 'mustard'
            assign hex = '#E5B33A'
            assign ink = '#122A55'
          when 'navy'
            assign hex = '#1F2A43'
          when 'hemp'
            assign hex = '#4F5232'
          when 'mystic-blue'
            assign hex = '#5068AB'
          when 'olive'
            assign hex = '#4A4C33'
          when 'oxford-navy'
            assign hex = '#1E2533'
          when 'pacific'
            assign hex = '#6C9FB5'
            assign ink = '#122A55'
          when 'pepper'
            assign hex = '#464340'
          when 'pink'
            assign hex = '#F1C8D6'
            assign ink = '#122A55'
          when 'royal-blue'
            assign hex = '#1E4597'
          when 'sage'
            assign hex = '#B8BFB0'
            assign ink = '#122A55'
          when 'stargazer'
            assign hex = '#2C6B7D'
          when 'teal'
            assign hex = '#4F8F8C'
          when 'terracotta'
            assign hex = '#D8865B'
            assign ink = '#122A55'
          when 'true-navy'
            assign hex = '#15284A'
          when 'violet'
            assign hex = '#7474C1'
          when 'white'
            assign hex = '#F4F4F2'
            assign ink = '#122A55'
          when 'wine'
            assign hex = '#4D2A48'
          when 'yam'
            assign hex = '#BE531C'
          else
            assign hex = '#2a3a5c'
        endcase
        # Caps (Flexfit 6277): the cap's own shade, the same hexes as the website's caps deck (Eric, 21 Nov 2026,
        # "Cap tabs should match the caps"). The Side Mark comes in any colour; its card shows black.
        if p.tags contains 'flexfit-6277'
          assign ink = '#F3F6F9'
          case key
            when 'navy'
              assign hex = '#1F2A43'
            when 'royal-blue'
              assign hex = '#1E4597'
            when 'grey'
              assign hex = '#7A7C7E'
            when 'black'
              assign hex = '#212327'
            when 'red'
              assign hex = '#B3262E'
            when 'khaki'
              assign hex = '#BDAA97'
              assign ink = '#122A55'
            when 'olive'
              assign hex = '#4A4C33'
            when 'dark-grey'
              assign hex = '#484A4B'
            when 'white'
              assign hex = '#F4F4F2'
              assign ink = '#122A55'
            else
              assign hex = '#212327'
          endcase
        endif
        assign spine = ''
        if cap_key != blank
          case cap_key
            when 'navy'
              assign cap_hex = '#1F2A43'
            when 'royal-blue'
              assign cap_hex = '#1E4597'
            when 'grey'
              assign cap_hex = '#7A7C7E'
            when 'red'
              assign cap_hex = '#B3262E'
            when 'khaki'
              assign cap_hex = '#BDAA97'
            when 'olive'
              assign cap_hex = '#4A4C33'
            when 'dark-grey'
              assign cap_hex = '#484A4B'
            when 'white'
              assign cap_hex = '#F4F4F2'
            else
              assign cap_hex = '#212327'
          endcase
          assign spine = 'linear-gradient(155deg, ' | append: cap_hex | append: ' calc(50% - .5px), ' | append: hex | append: ' calc(50% + .5px))'
        endif
        # Three views per card, front then side then back (Eric, 21 Nov 2026: all cards should have 3 placements).
        # Picked by image alt text so photo order does not matter; no front in the alts: the featured image.
        # A close-up stands in when there is no side; watermarked art previews are skipped.
        assign v_front = nil
        assign v_side = nil
        assign v_back = nil
        assign v_close = nil
        for m in p.images limit: 24
          assign a = m.alt | downcase | remove: 'beside'
          if a contains 'watermark'
            continue
          endif
          if v_front == blank and a contains 'front'
            assign v_front = m
          elsif v_side == blank and a contains 'side'
            assign v_side = m
          elsif v_close == blank and a contains 'close-up'
            assign v_close = m
          elsif v_back == blank and a contains 'back'
            assign v_back = m
          endif
        endfor
        if v_front == blank
          assign v_front = p.featured_image
        endif
        if v_side == blank
          assign v_side = v_close
        endif
        if v_side == v_front
          assign v_side = nil
        endif
        assign img2 = v_side
        assign img3 = v_back
        if img2 == blank
          assign img2 = img3
          assign img3 = nil
        endif
        assign sub = ''
        if organic_coll
          for t in p.tags
            if t contains 'organic:'
              assign sub = t | remove: 'organic:'
              break
            endif
          endfor
          if sub == 'beanie'
            assign sub = 'caps'
          endif
        endif
      -%}
      <article class="dk{% if light_pic %} dk--light{% endif %}"{% if sub != blank %} data-sub="{{ sub | escape }}"{% endif %} style="--hex: {{ hex }}; --ink: {{ ink }};{% if spine != blank %} --spine: {{ spine }};{% if ink == "#122A55" %} --spine-glow: rgba(255,255,255,.55);{% endif %}{% endif %}">
        <div class="dk-tag">
          <div class="ln">{{ ln | escape }}</div>
          <p class="t">{{ nm | escape }}</p>
          {%- if colour != blank -%}<p class="s">{{ colour | escape }}</p>{%- endif -%}
          <div class="r"><span class="p">{{ p.price_min | money }}{% if p.price_varies %}+{% endif %}</span><a href="{{ p.url }}">View &rarr;</a></div>
        </div>
        <a class="dk-face" href="{{ p.url }}" aria-label="{{ p.title | escape }}, {{ p.price_min | money }}">
          <span class="dk-spine"><span>{{ nm | replace: '’', "'" | escape }}</span></span>
          <span class="dk-pic{% if img3 %} n3{% elsif img2 %} n2{% else %} n1{% endif %}">
            {%- if v_front -%}
              <img {% if shown <= 2 %}src{% else %}data-src{% endif %}="{{ v_front | image_url: width: 700 }}" alt="" width="700" height="700" loading="lazy">
            {%- endif -%}
            {%- if img2 -%}<img data-src="{{ img2 | image_url: width: 700 }}" alt="" width="700" height="700" loading="lazy">{%- endif -%}
            {%- if img3 -%}<img data-src="{{ img3 | image_url: width: 700 }}" alt="" width="700" height="700" loading="lazy">{%- endif -%}
          </span>
        </a>
      </article>
    {%- endfor -%}
  {%- endfor -%}
  {%- if see_all and total > shown -%}
    <a class="dk-more" href="{{ coll.url }}">All {{ total }} &rarr;</a>
  {%- endif -%}
</div>
<p class="dsd-hint">{{ total }} {% if total == 1 %}design{% else %}designs{% endif %} · hover or tap a card · scroll for more</p>
